 "captions": [
  {"who": "cop", "text": "Write an FIR!", "in": 0.9, "out": 2.4},
  {"who": "cop", "text": "The Moon is on the run!", "in": 2.58, "out": 3.75},
  {"who": "guy", "text": "On the run?", "in": 4.0, "out": 5.0},
  {"who": "guy", "text": "Sir, I see it right here every night.", "in": 5.2, "out": 7.72},
  {"who": "cop", "text": "You see it, but it's slipping away!", "in": 7.93, "out": 10.15},
  {"who": "cop", "text": "Every year, 3.8 cm further!", "in": 10.34, "out": 12.95},
  {"who": "guy", "text": "True, sir.", "in": 13.2, "out": 14.36},
  {"who": "guy", "text": "Apollo left mirrors on the Moon.", "in": 14.4, "out": 16.92},
  {"who": "guy", "text": "Fire a laser, time the light's return,", "in": 16.96, "out": 19.78},
  {"who": "guy", "text": "and you've got the distance.", "in": 19.8, "out": 21.15},
  {"who": "cop", "text": "So why is it running away?", "in": 21.42, "out": 23.0},
  {"who": "guy", "text": "Tides!", "in": 23.26, "out": 25.62},
  {"who": "guy", "text": "Earth's oceans tug the Moon forward,", "in": 25.66, "out": 28.58},
  {"who": "guy", "text": "so its orbit keeps getting bigger.", "in": 28.62, "out": 31.03},
  {"who": "guy", "text": "In return, Earth's day is getting longer.", "in": 31.06, "out": 33.8},
  {"who": "cop", "text": "So my holiday gets longer?", "in": 34.09, "out": 35.62},
  {"who": "guy", "text": "In 100 years,", "in": 35.87, "out": 36.8},
  {"who": "guy", "text": "about 2 milliseconds, sir.", "in": 36.83, "out": 38.85},
  {"who": "cop", "text": "How far will the Moon move in 100 years?", "in": 41.73, "out": 43.93},
  {"who": "cop", "text": "Comment!", "in": 44.05, "out": 44.75},
  {"who": "cop", "text": "Hit subscribe?", "in": 45.25, "out": 46.42},
  {"who": "cop", "text": "No?", "in": 46.85, "out": 47.42},
  {"who": "cop", "text": "A ticket heavier than gravity!", "in": 47.65, "out": 49.6},
  {"who": "guy", "text": "One more cutting chai, then see you!", "in": 49.87, "out": 51.92},
  {"who": "cop", "text": "Next ticket...", "in": 52.17, "out": 53.1},
  {"who": "cop", "text": "the Sun's electricity bill!", "in": 53.46, "out": 55.35},
  {"who": "guy", "text": "Sir...", "in": 55.6, "out": 56.52},
  {"who": "guy", "text": "the Moon has moved a little further again!", "in": 56.56, "out": 58.7}
