  {"who": "guy", "text": "in just 225 days!", "in": 12.41, "out": 13.85},
  {"who": "guy", "text": "Its day is longer than its year!", "in": 13.97, "out": 15.73},
  {"who": "cop", "text": "Is it running backwards?", "in": 15.98, "out": 17.42},
