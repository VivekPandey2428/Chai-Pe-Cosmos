  "words": [
   {
    "text": "Wherever I go, the Moon follows me!",
    "start": 0.26,
    "end": 3.297
   },
   {
    "text": "Chasing an Inspector? The nerve!",
    "start": 3.477,
    "end": 5.773
   }
  ]
 },
 {
  "id": "g1",
  "speaker": "guy",
  "start": 5.79,
  "words": [
   {
    "text": "Not chasing, sir: the Moon is very far,",
    "start": 5.923,
    "end": 9.197
   },
   {
    "text": "about 3,84,000 km!",
    "start": 9.297,
    "end": 12.297
   }
  ]
 },
 {
  "id": "g2",
  "speaker": "guy",
  "start": 12.373,
  "words": [
   {
    "text": "Nearby trees and poles fall behind fast...",
    "start": 12.447,
    "end": 15.484
   }
  ]
 },
 {
  "id": "g3",
  "speaker": "guy",
  "start": 15.57,
  "words": [
   {
    "text": "...but something that far never changes direction.",
    "start": 15.634,
    "end": 18.459
   }
  ]
 },
 {
  "id": "c5",
  "speaker": "cop",
  "start": 18.529,
  "words": [
   {
    "text": "So the Moon isn't my fan?",
    "start": 18.659,
    "end": 20.77
   }
  ]
 },
 {
  "id": "g4",
  "speaker": "guy",
  "start": 20.896,
  "words": [
   {
    "text": "Watch tonight as you walk:",
    "start": 20.97,
    "end": 22.415
   },
   {
    "text": "the tree runs, the Moon stays!",
    "start": 22.595,
    "end": 25.113
   }
  ]
 },
 {
  "id": "c2",
  "speaker": "cop",
  "start": 25.367,
  "words": [
   {
    "text": "By the way, how fast is the Moon itself moving?",
    "start": 25.413,
    "end": 28.173
   },
   {
    "text": "Guess and comment!",
    "start": 28.353,
    "end": 29.714
   }
  ]
 },
 {
  "id": "g5",
  "speaker": "guy",
  "start": 30.566,
  "words": [
   {
    "text": "Sir, the Moon is still behind you...",
    "start": 30.714,
    "end": 33.455
   }
  ]
 }
