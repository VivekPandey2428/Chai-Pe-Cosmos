[
 {
  "id": "c1",
  "speaker": "cop",
  "start": 0.038,
  "words": [
   {
    "text": "Why does the Sun turn red in the evening?",
    "start": 0.26,
    "end": 2.927
   },
   {
    "text": "Is it blushing?",
    "start": 3.027,
    "end": 4.212
   }
  ]
 },
 {
  "id": "g1",
  "speaker": "guy",
  "start": 3.547,
  "words": [
   {
    "text": "Not blushing, sir:",
    "start": 4.362,
    "end": 5.843
   },
   {
    "text": "a long road!",
    "start": 5.991,
    "end": 7.103
   }
  ]
 },
 {
  "id": "g2",
  "speaker": "guy",
  "start": 7.178,
  "words": [
   {
    "text": "In the evening sunlight slants,",
    "start": 7.252,
    "end": 8.817
   },
   {
    "text": "so it crosses about 40× more air than at noon!",
    "start": 8.997,
    "end": 12.154
   }
  ]
 },
 {
  "id": "g3",
  "speaker": "guy",
  "start": 12.23,
  "words": [
   {
    "text": "And blue scatters the most,",
    "start": 12.304,
    "end": 14.36
   },
   {
    "text": "so blue gets off on the way.",
    "start": 14.54,
    "end": 15.771
   },
   {
    "text": "Only red-orange arrives!",
    "start": 15.951,
    "end": 17.627
   }
  ]
 },
 {
  "id": "c2",
  "speaker": "cop",
  "start": 17.753,
  "words": [
   {
    "text": "Blue deserves a challan:",
    "start": 17.827,
    "end": 19.651
   },
   {
    "text": "it got off mid-route!",
    "start": 19.831,
    "end": 21.22
   }
  ]
 },
 {
  "id": "c3",
  "speaker": "cop",
  "start": 21.496,
  "words": [
   {
    "text": "Mars is the RED planet...",
    "start": 21.57,
    "end": 23.459
   },
   {
    "text": "so what colour is its sunset? Comment!",
    "start": 23.639,
    "end": 26.037
   }
  ]
 },
 {
  "id": "c4",
  "speaker": "cop",
  "start": 26.789,
  "words": [
   {
    "text": "Next question...",
    "start": 26.937,
    "end": 28.493
   },
   {
    "text": "why does the Moon follow us?",
    "start": 28.593,
    "end": 30.963
   }
  ]
 },
 {
  "id": "g4",
  "speaker": "guy",
  "start": 31.189,
  "words": [
   {
    "text": "Look, sir,",
    "start": 31.263,
    "end": 32.004
   },
   {
    "text": "it's red again...",
    "start": 32.184,
    "end": 33.147
   }
  ]
 }
]